{
  "name": "agent-router",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "bin": {
    "router": "./bin/router.mjs"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite --config dashboard/vite.config.js",
    "build": "vite build --config dashboard/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "e2e": "node pruebas/e2e-dashboard.mjs",
    "instalar": "node bin/instalar.mjs",
    "desinstalar": "node bin/instalar.mjs --desinstalar"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.13.0",
    "supertest": "^7.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
